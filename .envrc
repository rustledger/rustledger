# Direnv configuration for rustledger
# See: https://direnv.net/

# Use Nix flake development shell
use flake

# Watch for changes in flake files
watch_file flake.nix
watch_file flake.lock

# Project-local cargo target directory (optional - faster builds, more disk)
# export CARGO_TARGET_DIR="${PWD}/.cargo-target"

# Rust configuration
export RUST_BACKTRACE=1
export RUST_LOG=info

# Colored cargo output
export CARGO_TERM_COLOR=always

# Use mold linker if available (faster linking on Linux). Link through the
# dev shell's default `cc` (GCC >= 12 understands `-fuse-ld=mold`): forcing
# `clang` as the linker broke every build, because the flake does not provide
# clang, and mold is often on PATH from the user's profile without it.
if command -v mold &>/dev/null && [[ "$(uname)" == "Linux" ]]; then
  export RUSTFLAGS="-C link-arg=-fuse-ld=mold"
fi
