plugin "beancount.plugins.sellgains"
2020-01-01 open Assets:Stock
2020-01-01 open Assets:Cash
2020-01-01 open Income:Gains
2020-01-02 * "buy"
  Assets:Stock   1 HOOL {10 USD}
  Assets:Cash  -10 USD
2020-01-03 * "sell with a price that disagrees with the proceeds"
  Assets:Stock  -1 HOOL {10 USD} @ 20 USD
  Assets:Cash   15 USD
  Income:Gains  -5 USD
