{
  "$schema": "https://opencode.ai/config.json",
  "model": "togetherai/Qwen/Qwen3.5-397B-A17B",
  "small_model": "togetherai/meta-llama/Llama-3.3-70B-Instruct-Turbo",
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    ".opencode/agents/*.md"
  ],
  "tools": {
    "write": true,
    "edit": true,
    "bash": true
  },
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "mcp": {},
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "**/*.lock",
      "target/**"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  }
}