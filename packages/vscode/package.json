{
  "name": "rustledger-vscode",
  "displayName": "rustledger",
  "description": "Beancount language support powered by rustledger \u2014 completions, diagnostics, formatting, and more",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/rustledger/rustledger",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/rustledger/rustledger/issues"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "beancount",
    "accounting",
    "ledger",
    "plaintext accounting",
    "double-entry"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "beancount",
        "aliases": [
          "Beancount",
          "beancount"
        ],
        "extensions": [
          ".beancount",
          ".bean"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "rustledger.restartServer",
        "title": "Restart Language Server",
        "category": "rustledger"
      },
      {
        "command": "rustledger.checkForUpdates",
        "title": "Check for Updates",
        "category": "rustledger"
      }
    ],
    "configuration": {
      "title": "rustledger",
      "properties": {
        "rustledger.server.path": {
          "type": "string",
          "default": "rledger-lsp",
          "description": "Path to the rledger-lsp binary"
        },
        "rustledger.server.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to rledger-lsp"
        },
        "rustledger.journalFile": {
          "type": "string",
          "default": "",
          "description": "Path to the root journal file. Relative paths resolve against the workspace folder, so each folder in a multi-root workspace can point at its own ledger from its .vscode/settings.json. Leave empty to auto-discover.",
          "scope": "resource"
        },
        "rustledger.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check for extension updates on startup"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --watch",
    "package": "npm run build && vsce package --no-dependencies -o rustledger-vscode.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "fast-uri": "^3.1.5",
    "linkify-it": "^5.0.2",
    "js-yaml": "^4.3.0"
  }
}
